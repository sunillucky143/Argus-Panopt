# Copy this file to the repository root as .env. Values marked below are for
# local smoke tests only and must be replaced before any shared deployment.

# Application
ARGUS_ENVIRONMENT=development
ARGUS_APP_VERSION=0.1.0
ARGUS_LOG_LEVEL=INFO
ARGUS_CORS_ORIGINS=http://localhost:8080
ARGUS_WEB_PORT=8080
ARGUS_TIER=S

# Resource budgets
ARGUS_API_CPUS=1.0
ARGUS_API_MEMORY=768m
ARGUS_WEB_CPUS=0.5
ARGUS_WEB_MEMORY=128m
ARGUS_POSTGRES_CPUS=1.0
ARGUS_POSTGRES_MEMORY=1g
ARGUS_REDIS_CPUS=0.5
ARGUS_REDIS_MEMORY=256m
ARGUS_LLAMA_CPUS=6.0
ARGUS_LLAMA_MEMORY=8g
ARGUS_LLAMA_THREADS=8
ARGUS_LLAMA_PARALLEL=1
ARGUS_VLLM_CPUS=8.0
ARGUS_VLLM_MEMORY=16g
ARGUS_VLLM_GPU_MEMORY_UTILIZATION=0.90
ARGUS_VLLM_MAX_NUM_SEQS=30
ARGUS_RETRIEVAL_GATEWAY_CPUS=0.5
ARGUS_RETRIEVAL_GATEWAY_MEMORY=256m
ARGUS_EMBEDDING_CPUS=2.0
ARGUS_EMBEDDING_MEMORY=4g
ARGUS_EMBEDDING_THREADS=4
ARGUS_RERANKER_CPUS=2.0
ARGUS_RERANKER_MEMORY=4g
ARGUS_RERANKER_THREADS=4

# PostgreSQL 16 + pgvector
POSTGRES_DB=argus
POSTGRES_USER=argus
POSTGRES_PASSWORD=replace-before-production-postgres
ARGUS_DATABASE_URL=postgresql+asyncpg://argus@postgres:5432/argus

# Redis 7
REDIS_PASSWORD=replace-before-production-redis
ARGUS_REDIS_URL=redis://redis:6379/0

# OIDC / Keycloak (Phase 5)
ARGUS_OIDC_ISSUER=http://keycloak:8080/realms/argus
ARGUS_OIDC_AUDIENCE=argus-api
ARGUS_OIDC_CLIENT_ID=argus-web
ARGUS_ACCESS_TOKEN_TTL_SECONDS=300
ARGUS_IDLE_TIMEOUT_SECONDS=900

# Upload and retention (Phases 2 and 5)
ARGUS_MAX_UPLOAD_BYTES=104857600
ARGUS_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
ARGUS_DEFAULT_RETENTION_MODE=ephemeral
ARGUS_TEMP_DIRECTORY=/tmp/argus

# Local model adapter (Phase 1)
# Tier S CPU runtime. Provision and verify the pinned model before preflight.
ARGUS_DEBUG_INFERENCE_ENABLED=true
ARGUS_MODEL_PROVIDER=llama_cpp
ARGUS_MODEL_NAME=gemma-3-4b-it
ARGUS_MODEL_ENDPOINT=http://inference-cpu:8080/v1
ARGUS_MODEL_CONTEXT_CEILING=32768
ARGUS_MODEL_TEMPERATURE=0
ARGUS_EMBEDDING_ENDPOINT=http://embedding-service:8081
ARGUS_EMBEDDING_MODEL=bge-m3
ARGUS_RERANKER_MODEL=bge-reranker-v2-m3
ARGUS_RETRIEVAL_TIMEOUT_SECONDS=120

# Tier M GPU runtime: replace the five Tier S values above before running
# `./deploy/preflight.sh gpu` or `docker compose --profile gpu up`:
# ARGUS_TIER=M
# ARGUS_MODEL_PROVIDER=vllm
# ARGUS_MODEL_NAME=qwen2.5-vl-7b-instruct-awq
# ARGUS_MODEL_ENDPOINT=http://inference-gpu:8000/v1
# ARGUS_MODEL_CONTEXT_CEILING=65536

# Self-hosted observability (Phase 6)
ARGUS_PROMETHEUS_URL=http://prometheus:9090
ARGUS_LANGFUSE_URL=http://langfuse:3000
ARGUS_LANGFUSE_PUBLIC_KEY=replace-before-production-public
ARGUS_LANGFUSE_SECRET_KEY=replace-before-production-secret
ARGUS_TRACE_RETENTION_DAYS=30
ARGUS_PII_MASKING_ENABLED=true

# Parser sandbox (Phase 2)
ARGUS_PARSER_VERSION=not-configured
ARGUS_PARSER_CPUS=2.0
ARGUS_PARSER_MEMORY=4g
ARGUS_CLAMAV_HOST=clamav
ARGUS_CLAMAV_PORT=3310
